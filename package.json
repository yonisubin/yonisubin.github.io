{
  "name": "city-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:civ": "vite --config civilization/vite.config.ts",
    "build:civ": "tsc --noEmit -p civilization && vite build --config civilization/vite.config.ts",
    "preview:civ": "vite preview --config civilization/vite.config.ts",
    "typecheck:civ": "tsc --noEmit -p civilization",
    "server:civ": "node civilization/server/server.mjs",
    "test:civ": "node civilization/tests/run.mjs",
    "dev:portal": "vite --config portal/vite.config.ts",
    "build:portal": "tsc --noEmit -p portal && vite build --config portal/vite.config.ts",
    "preview:portal": "vite preview --config portal/vite.config.ts",
    "typecheck:portal": "tsc --noEmit -p portal",
    "test:portal": "node portal/tests/run.mjs",
    "build:characters": "node scripts/build-characters.mjs",
    "build:quaternius": "node scripts/build-quaternius.mjs",
    "test": "node tests/run.mjs",
    "rl:build": "node rl/build.mjs",
    "rl:viewer": "vite --config rl/viewer/vite.config.ts",
    "typecheck:rl": "tsc --noEmit -p rl"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "pixi.js": "8.22.0",
    "three": "^0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
